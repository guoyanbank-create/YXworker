# 复制到 ~/.config/yxworker/credentials.env 并 chmod 600；不要提交到仓库。
# 模型网关（OpenAI 兼容，需支持 json_object；不支持 json_schema）
YXWORKER_LLM_PROVIDER=openai-compatible
YXWORKER_LLM_BASE_URL=https://<gateway-host>/v1
YXWORKER_LLM_API_KEY=<secret>
YXWORKER_LLM_MODEL=deepseek-flash
YXWORKER_LLM_MODEL_PRO=deepseek-v4-pro
YXWORKER_TIER_DRAFT=deepseek-flash
YXWORKER_TIER_REVIEW=deepseek-flash
YXWORKER_TIER_LONG_REASONING=deepseek-v4-pro

# DeepSeek 官方 anthropic 端点（可选，作为 provider 备选）
DEEPSEEK_API_KEY=<secret>
DEEPSEEK_ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
DEEPSEEK_MODEL=deepseek-flash
