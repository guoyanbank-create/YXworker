# 非敏感运行配置示例（可复制为 .env 或用环境变量注入；真实密钥不要写进仓库）
# 端口/监听地址：仅本机使用，保持 127.0.0.1
PORT=8787
HOST=127.0.0.1

# 数据目录（SQLite + WAL + 上传提取文本），默认仓库根 .data/
# YXWORKER_DATA_DIR=./.data

# 模型凭据文件（默认 ~/.config/yxworker/credentials.env，chmod 600）
# YXWORKER_CREDENTIALS_FILE=~/.config/yxworker/credentials.env

# 故障注入（本机验收 §11.7 演示用；生产可设 0 关闭）
YXWORKER_FAULT_INJECTION=1

# 强制离线模拟（1 = 只用 Mock 执行器）
YXWORKER_MOCK_ONLY=0
